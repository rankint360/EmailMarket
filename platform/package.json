  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  }
}
